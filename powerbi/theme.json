{
  "name": "Ecommerce Sales Clean",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#6250D6", "#E34948"],
  "background": "#FCFCFB",
  "foreground": "#0B0B0B",
  "tableAccent": "#2A78D6",
  "good": "#1BAF7A",
  "neutral": "#EDA100",
  "bad": "#E34948",
  "maximum": "#0D366B",
  "center": "#86B6EF",
  "minimum": "#CDE2FB",
  "null": "#A9A8A3",
  "textClasses": {
    "label": { "fontSize": 11, "fontFace": "Segoe UI", "color": "#52514E" },
    "callout": { "fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "title": { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" },
    "header": { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0B0B0B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E3DF" } }, "radius": 6 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B0B0B" } }, "fontSize": 13, "alignment": "left" }],
        "visualHeader": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F2EF" } }, "transparency": 0 }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#0B0B0B" } }, "fontSize": 26 }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#52514E" } }, "fontSize": 11 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E4E3DF" } } }]
      }
    }
  }
}
