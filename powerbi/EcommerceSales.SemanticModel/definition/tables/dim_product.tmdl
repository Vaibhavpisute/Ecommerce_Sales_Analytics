table dim_product

	column product_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column product_id
		dataType: string
		summarizeBy: none
		sourceColumn: product_id

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category

	column weight_g
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: weight_g

	partition dim_product = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"product_key", Int64.Type}, {"product_id", type text}, {"category", type text}, {"weight_g", type number}}, "en-US")
			in
			    ChangedTypes
