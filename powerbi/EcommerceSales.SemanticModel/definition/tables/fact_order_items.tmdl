table fact_order_items

	/// Sum of item prices (without freight) of valid sales.
	measure 'Total Revenue' = SUM(fact_order_items[price])
		formatString: #,0.00
		displayFolder: Sales

	/// Number of valid orders that have items.
	measure 'Total Orders' = DISTINCTCOUNT(fact_order_items[order_key])
		formatString: #,0
		displayFolder: Sales

	/// Average order value = revenue / orders.
	measure AOV = DIVIDE([Total Revenue], [Total Orders])
		formatString: #,0.00
		displayFolder: Sales

	/// Sum of freight.
	measure 'Freight Value' = SUM(fact_order_items[freight_value])
		formatString: #,0.00
		displayFolder: Sales

	/// Number of items sold.
	measure 'Units Sold' = COUNTROWS(fact_order_items)
		formatString: #,0
		displayFolder: Sales

	/// Revenue of the month before.
	measure 'Revenue Previous Month' = CALCULATE([Total Revenue], DATEADD(dim_date[date], -1, MONTH))
		formatString: #,0.00
		displayFolder: Growth

	/// Month-over-month revenue growth. Empty unless a single month is in scope and both months are full months (same rule as SQL Q3).
	measure 'MoM Growth %' =
			VAR prevRevenue = [Revenue Previous Month]
			VAR bothMonthsComplete =
			    MAX(dim_date[analysis_flag]) = 1
			        && CALCULATE(MAX(dim_date[analysis_flag]), DATEADD(dim_date[date], -1, MONTH)) = 1
			RETURN
			    IF(
			        HASONEVALUE(dim_date[year_month]) && bothMonthsComplete,
			        DIVIDE([Total Revenue] - prevRevenue, prevRevenue)
			    )
		formatString: 0.0%
		displayFolder: Growth

	/// MoM growth of the last full month in the selected dates (for the KPI card).
	measure 'MoM Growth % (last full month)' =
			VAR lastMonth =
			    MAXX(
			        FILTER(
			            VALUES(dim_date[month_start]),
			            [Total Revenue] > 0 && CALCULATE(MAX(dim_date[analysis_flag])) = 1
			        ),
			        dim_date[month_start]
			    )
			RETURN
			    CALCULATE([MoM Growth %], dim_date[month_start] = lastMonth)
		formatString: 0.0%
		displayFolder: Growth

	/// Revenue from 1 January of the year to the date.
	measure 'Revenue YTD' = TOTALYTD([Total Revenue], dim_date[date])
		formatString: #,0
		displayFolder: Growth

	/// Share of the selected categories' revenue.
	measure 'Revenue Share %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALLSELECTED(dim_product[category])))
		formatString: 0.0%
		displayFolder: Products

	/// Rank of the category by revenue.
	measure 'Category Rank' = RANKX(ALLSELECTED(dim_product[category]), [Total Revenue], , DESC, Dense)
		formatString: 0
		displayFolder: Products

	/// Revenue, only for the 10 best categories (other categories are empty and hidden in charts).
	measure 'Revenue (Top 10 Categories)' = IF([Category Rank] <= 10, [Total Revenue])
		formatString: #,0
		displayFolder: Products

	/// Rank of the customer state by revenue.
	measure 'State Rank' = RANKX(ALLSELECTED(dim_state[state_name]), [Total Revenue], , DESC, Dense)
		formatString: 0
		displayFolder: Geography

	/// Revenue, only for the 10 best states (other states are empty and hidden in charts).
	measure 'Revenue (Top 10 States)' = IF([State Rank] <= 10, [Total Revenue])
		formatString: #,0
		displayFolder: Geography

	/// Pareto: running share of revenue when categories are sorted from high to low (first 20 categories).
	measure 'Cumulative Revenue % (Top 20)' =
			VAR currentRevenue = [Total Revenue]
			VAR allCategories = ALLSELECTED(dim_product[category])
			VAR cumulative = SUMX(FILTER(allCategories, [Total Revenue] >= currentRevenue), [Total Revenue])
			VAR total = SUMX(allCategories, [Total Revenue])
			RETURN
			    IF([Category Rank] <= 20, DIVIDE(cumulative, total))
		formatString: 0.0%
		displayFolder: Products

	column order_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: order_key

	column product_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column price
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: price

	column freight_value
		dataType: double
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: freight_value

	partition fact_order_items = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\fact_order_items.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"order_key", Int64.Type}, {"product_key", Int64.Type}, {"price", type number}, {"freight_value", type number}}, "en-US")
			in
			    ChangedTypes
