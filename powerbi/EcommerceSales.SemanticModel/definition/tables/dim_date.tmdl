table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		summarizeBy: none
		sourceColumn: date

	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	column quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	column month
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	column month_name
		dataType: string
		sortByColumn: month
		summarizeBy: none
		sourceColumn: month_name

	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	column month_start
		dataType: dateTime
		formatString: yyyy-mm
		summarizeBy: none
		sourceColumn: month_start

	column day_of_week
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: day_of_week

	column day_name
		dataType: string
		sortByColumn: day_of_week
		summarizeBy: none
		sourceColumn: day_name

	column is_weekend
		dataType: string
		summarizeBy: none
		sourceColumn: is_weekend

	column analysis_flag
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: analysis_flag

	column period_type
		dataType: string
		summarizeBy: none
		sourceColumn: period_type

	partition dim_date = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"month_start", type date}, {"day_of_week", Int64.Type}, {"day_name", type text}, {"is_weekend", type text}, {"analysis_flag", Int64.Type}, {"period_type", type text}}, "en-US")
			in
			    ChangedTypes
