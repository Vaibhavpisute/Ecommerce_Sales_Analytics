table dim_state

	column state
		dataType: string
		summarizeBy: none
		sourceColumn: state

	column state_name
		dataType: string
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: state_name

	column region
		dataType: string
		summarizeBy: none
		sourceColumn: region

	column country
		dataType: string
		dataCategory: Country
		summarizeBy: none
		sourceColumn: country

	partition dim_state = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\dim_state.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"state", type text}, {"state_name", type text}, {"region", type text}, {"country", type text}}, "en-US")
			in
			    ChangedTypes
