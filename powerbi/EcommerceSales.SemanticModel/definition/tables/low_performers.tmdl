table low_performers

	column product_key
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: product_key

	column reviewed_orders
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: reviewed_orders

	column avg_rating
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: avg_rating

	column low_score_pct
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: low_score_pct

	column overall_avg_rating
		dataType: double
		formatString: 0.00
		summarizeBy: none
		sourceColumn: overall_avg_rating

	partition low_performers = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(Text.TrimEnd(DataFolder, "\") & "\low_performers.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{"product_key", Int64.Type}, {"reviewed_orders", Int64.Type}, {"avg_rating", type number}, {"low_score_pct", type number}, {"overall_avg_rating", type number}}, "en-US")
			in
			    ChangedTypes
