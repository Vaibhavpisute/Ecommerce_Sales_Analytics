{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "c1_bar_segments",
  "position": {
    "x": 505,
    "y": 444,
    "z": 13,
    "height": 266,
    "width": 360,
    "tabOrder": 13
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_customer"
                    }
                  },
                  "Property": "segment"
                }
              },
              "queryRef": "dim_customer.segment",
              "nativeQueryRef": "segment",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_orders"
                    }
                  },
                  "Property": "Active Customers"
                }
              },
              "queryRef": "fact_orders.Active Customers",
              "nativeQueryRef": "Active Customers"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Customers by RFM segment'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
